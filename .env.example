# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one provider and set its API key below.
# Free option: groq (sign up at https://console.groq.com)

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# API keys — set the one matching your LLM_PROVIDER
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Data paths (auto-configured in Docker) ────────────────────────────────────
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# ── Embedding model (runs locally, no API key needed) ─────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2

# ── Date override (leave blank to use system date) ────────────────────────────
APP_TODAY=
